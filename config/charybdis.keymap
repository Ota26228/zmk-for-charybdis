#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&none  &none       &none           &none        &none        &none        &none        &none        &none        &none            &none                  &none
&none  &mt TAB Q   &kp W           &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O            &kp P                  &none
&none  &mt LWIN A  &mt LEFT_ALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H        &mt LSHFT J  &mt LCTRL K  &mt RIGHT_ALT L  &mt LWIN SINGLE_QUOTE  &none
&none  &kp Z       &kp X           &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT          &lt 3 SLASH            &none
                                   &kp ESCAPE   &lt 5 SPACE  &lt 4 TAB    &lt 2 ENTER  &lt 1 BSPC
                                                &none        &none        &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none             &none         &none         &none         &none                   &none  &none      &none      &none         &none     &none
&none  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET       &none  &none      &none      &none         &none     &none
&none  &kp SEMICOLON     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp EQUAL               &none  &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LCMD  &none
&none  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NON_US_BACKSLASH    &none  &none      &none      &none         &none     &none
                                       &kp PERIOD    &kp N0        &kp MINUS               &none  &none
                                                     &none         &none                   &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none           &none       &none                 &none                  &none              &none   &none      &none      &none         &none     &none
&none  &kp LEFT_BRACE  &kp AMPS    &kp ASTERISK          &kp LEFT_BRACE         &kp RIGHT_BRACE    &none   &none      &none      &none         &none     &none
&none  &kp COLON       &kp DOLLAR  &kp PERCENT           &kp CARET              &kp PLUS           &none   &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LWIN  &none
&none  &kp TILDE       &kp EXCL    &kp AT                &kp HASH               &kp PIPE           &none   &none      &none      &none         &none     &none
                                   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &none
                                                         &none                  &none              &none
            >;
        };

        Mouse {
            bindings = <
&none        &none     &none         &none      &none      &none        &none       &none      &none         &none         &none         &none
&none        &none     &none         &none      &none      &none        &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none        &none       &kp LSHFT  &kp LCTRL     &kp LEFT_ALT  &kp LWIN      &none
&bootloader  &trans    &none         &mo 4      &none      &none        &none       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                     &none      &mkp LCLK  &mkp RCLK    &mkp RCLK   &mkp LCLK
                                                &none      &none        &none
            >;
        };

        layer_4 {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none   &none   &none    &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &kp F7     &kp F8  &kp F9  &kp F12  &none
&none        &kp LCMD      &kp LEFT_ALT  &kp LCTRL     &kp LSHFT  &none         &none       &kp F4     &kp F5  &kp F6  &kp F11  &none
&bootloader  &none         &mkp RCLK     &trans        &mkp LCLK  &none         &none       &kp F1     &kp F2  &kp F3  &kp F10  &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans    &trans    &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans    &trans    &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp CAPSLOCK  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp INS       &trans    &trans    &trans  &trans     &trans
                        &trans  &trans  &trans    &kp ENTER     &kp BSPC
                                &trans  &trans    &trans
            >;
        };
    };
};
