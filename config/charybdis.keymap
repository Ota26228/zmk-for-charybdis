#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&none  &none      &none           &none       &none     &none               &none        &none      &none      &none            &none            &none
&none  &mt TAB Q  &kp W           &kp E       &kp R     &kp T               &kp Y        &kp U      &kp I      &kp O            &mt BACKSPACE P  &none
&none  &kp A      &mt LEFT_ALT S  &kp D       &kp F     &kp G               &kp H        &kp J      &kp K      &mt RIGHT_ALT L  &mt ENTER SEMI   &none
&none  &kp Z      &kp X           &kp C       &kp V     &kp B               &kp N        &kp M      &kp COMMA  &kp DOT          &lt 3 SLASH      &none
                                  &kp ESCAPE  &kp LWIN  &lt 2 LEFT_SHIFT    &lt 1 SPACE  &kp RCTRL
                                              &none     &none               &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none         &none         &none         &none         &none     &none         &none             &none                 &none                 &none              &none
&none  &kp GRAVE     &none         &none         &none         &none     &none         &none             &none                 &kp LS(LEFT_BRACKET)  &kp RIGHT_BRACKET  &none
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7            &kp N8                &mt RSHIFT N9         &mt RCTRL N0       &kp PAGE_UP
&none  &none         &none         &none         &none         &none     &none         &kp SINGLE_QUOTE  &kp NON_US_BACKSLASH  &kp MINUS             &kp EQUAL          &kp PAGE_DOWN
                                   &kp ESCAPE    &kp LWIN      &trans    &kp ENTER     &kp RIGHT_ALT
                                                 &none         &none     &none
            >;
        };

        layer_2 {
            bindings = <
&none          &none               &none               &none               &kp F4              &kp F5                &kp F6              &kp F7              &kp F8              &kp F9              &kp F10              &kp F11
&kp LS(GRAVE)  &mt F1 KP_NUMBER_1  &mt F2 KP_NUMBER_2  &mt F3 KP_NUMBER_3  &mt F4 KP_NUMBER_4  &mt F5 KP_NUMBER_5    &mt F6 KP_NUMBER_6  &mt F7 KP_NUMBER_7  &mt F8 KP_NUMBER_8  &mt F9 KP_NUMBER_9  &mt F10 KP_NUMBER_0  &none
&kp LSHFT      &kp NUMBER_1        &kp NUMBER_2        &kp KP_NUMBER_3     &kp KP_NUMBER_4     &kp KP_NUMBER_5       &kp KP_NUMBER_6     &kp KP_NUMBER_7     &kp KP_NUMBER_8     &kp KP_NUMBER_9     &kp KP_NUMBER_0      &none
&kp LCTRL      &kp LS(N9)          &kp LS(N0)          &kp LS(MINUS)       &kp LS(EQUAL)       &none                 &none               &kp LEFT            &kp DOWN            &kp RIGHT           &kp F12              &none
                                                       &kp ESCAPE          &kp LWIN            &kp ENTER             &trans              &kp RIGHT_ALT
                                                                           &none               &none                 &none
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &none         &none       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        layer_4 {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &trans        &mkp LCLK  &none         &none       &mkp LCLK  &trans        &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };
    };
};
